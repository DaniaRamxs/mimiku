{
  "name": "mimiku",
  "version": "2.0.0",
  "description": "Plataforma de engagement para streamers y VTubers",
  "main": "main.cjs",
  "author": "Mimiku contributors",
  "scripts": {
    "test": "node scripts/run-tests-isolated.cjs",
    "test:node": "node --test tests/**/*.test.js",
    "check:syntax": "node scripts/check-syntax.cjs",
    "check:distribution": "node scripts/check-distribution.cjs",
    "verify": "npm run check:syntax && npm run check:distribution && npm test",
    "backup": "node scripts/backup.cjs",
    "prestart": "npm run rebuild:electron",
    "start": "electron .",
    "rebuild": "npm run rebuild:electron",
    "rebuild:electron": "cd node_modules/better-sqlite3 && npx node-gyp rebuild --target=35.7.5 --dist-url=https://electronjs.org/headers --arch=x64",
    "predist": "npm run rebuild:electron && npm run check:syntax",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "better-sqlite3": "^11.0.0",
    "tmi.js": "^1.8.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.5",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "fun.mimiku.app",
    "productName": "Mimiku",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "src/**/*",
      "README.md",
      "CHANGELOG.md",
      "SECURITY.md",
      "THIRD_PARTY_NOTICES.md",
      "docs/live-testing-checklist.md",
      "docs/social-stream-ninja-integration.md",
      "mod-panel/index.html",
      "mod-panel/app.js",
      "mod-panel/style.css",
      "!src/**/*.map",
      "!**/fix-*.js",
      "!**/.env*"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Mimiku-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mimiku",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "menuCategory": false,
      "include": "build/installer.nsh"
    }
  },
  "optionalDependencies": {
    "tiktok-live-connector": "2.5.0"
  }
}
